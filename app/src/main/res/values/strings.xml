    <!-- Unit Descriptions -->
    <string name="unit2_title">Unit 2: Android Platform &amp; UI Basics</string>
    <string name="unit2_desc">Topics: Platform, Environment Setup, View Hierarchy, Widget Attributes, String Resources, Emulator.\nExample: Welcome screen layout with ConstraintLayout &amp; Toasts.</string>

    <string name="unit3_title">Unit 3: Layouts, Widgets &amp; Event Handling</string>
    <string name="unit3_desc">Topics: Linear/Relative/Constraint Layouts, TextView, EditText, CheckBox, RadioButton, Spinner.\nExample: Add Expense Form with validation &amp; event listeners.</string>

    <string name="unit4_title">Unit 4: Activity Lifecycle &amp; Intents</string>
    <string name="unit4_desc">Topics: Lifecycle hooks (onCreate, onResume), Multiple Activities, Explicit Intents, Passing Data.\nExample: Navigating between Dashboard and Add Expense.</string>

    <string name="unit5_title">Unit 5: Fragments &amp; Dialogs</string>
    <string name="unit5_desc">Topics: Fragment Lifecycle, FragmentManager, Options/Context Menus, AlertDialog, Custom Dialogs.\nExample: Tabbed Dashboard &amp; Edit Expense dialogs.</string>

    <string name="unit6_title">Unit 6: Lists, Adapters &amp; RecyclerView</string>
    <string name="unit6_desc">Topics: ListView, GridView, RecyclerView, Adapter, ViewHolder, LayoutManager.\nExample: Expense History dynamic list with CardView.</string>

    <string name="unit7_title">Unit 7: Database, API &amp; Publishing</string>
    <string name="unit7_desc">Topics: SQLite Database (CRUD), REST API Integration, JSON Parsing, Google Maps, App Publishing.\nExample: Storing expenses locally &amp; syncing currencies.</string>
</resources>
