<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipToPadding="false"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_projects"
            android:textColor="@color/primary_green_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Project 1 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/primary_green"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phase 1 &amp; 2: Expense Input Form"
                    android:textColor="@color/accent_teal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Practice UI layouts, View hierarchies, EditText validation, Spinners, and CheckBoxes by opening the fully functional Expense Tracker form."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenExpenseForm"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Open Expense Tracker Form"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/primary_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Project 2 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/primary_green"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phase 3 &amp; 4: Fragment Tabs &amp; Dialogs"
                    android:textColor="@color/accent_teal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Practice Bottom Navigation, FragmentTransactions, Options Menus, and custom AlertDialogs."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenProject2"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="View Fragment Demo"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/primary_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Project 3 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/primary_green"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phase 5 &amp; 6: SQLite DB &amp; RecyclerView"
                    android:textColor="@color/accent_teal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Practice SQLite CRUD operations, Cursor adapters, RecyclerView, and ViewHolder pattern."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenProject3"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="View Database Demo"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/primary_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
