<?xml version="1.0" encoding="utf-8"?>
<!--
    Lab 2: Unit 3 - Layout Types & Basic Widgets
    Demonstrates ConstraintLayout combined with LinearLayout for form design,
    using TextView, EditText (with inputType), and MaterialButton.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:padding="24dp"
    tools:context=".AddExpenseActivity">

    <!-- Lab Header -->
    <TextView
        android:id="@+id/tvLab2Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lab2_title"
        android:textAllCaps="true"
        android:textColor="@color/accent_teal"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Form Container Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeColor="@color/primary_green"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLab2Title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Form Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_expense"
                android:textColor="@color/primary_green_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Expense Title Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_title"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!--
                EditText for Expense Title
                Demonstrates inputType="text" and hint attributes.
            -->
            <EditText
                android:id="@+id/etExpenseTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/background_light"
                android:hint="@string/hint_expense_title"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp"
                android:layout_marginBottom="20dp"
                android:autofillHints="name" />

            <!-- Expense Amount Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_amount"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!--
                EditText for Expense Amount
                Demonstrates inputType="numberDecimal" for numeric keypad.
            -->
            <EditText
                android:id="@+id/etExpenseAmount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/background_light"
                android:hint="@string/hint_expense_amount"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:autofillHints="postalAddress" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Save Button with Event Handling -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveExpense"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="@string/btn_save_expense"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
